{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueLink",
  "version": "1.0.0",
  "identifier": "game.bluelink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "BlueLink",
      "width": 1100,
      "height": 760,
      "minWidth": 820,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "backgroundColor": "#FFD500"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../data/articles.sqlite": "articles.sqlite"
    },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
